{
  "version": "0.0.0",
  "name": "installments-info",
  "private": true,
  "scripts": {
    "lint": "eslint --ext js,jsx,ts,tsx .",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json}\"",
    "lint:locales": "intl-equalizer",
    "sass": "concurrently \"sass --watch --no-source-map react/styles:react\"",
    "sass-react": "sass --watch --no-source-map react/styles:react --style compressed"
  },
  "intl-equalizer": {
    "referenceLocale": "en",
    "localeDirectory": "messages"
  },
  "lint-staged": {
    "*.{ts,js,tsx,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.json": [
      "prettier --write"
    ],
    "messages/*.json": [
      "yarn lint:locales"
    ]
  },
  "devDependencies": {
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^5.20.0",
    "@typescript-eslint/parser": "^5.20.0",
    "@vtex/danger": "^0.2.7",
    "@vtex/intl-equalizer": "^2.5.0",
    "@vtex/prettier-config": "^1.0.0",
    "@vtex/tsconfig": "^0.6.0",
    "concurrently": "^7.1.0",
    "eslint": "8.13.0",
    "eslint-config-vtex": "^15.0.0",
    "eslint-config-vtex-react": "^9.0.0",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-jest": "^26.1.4",
    "eslint-plugin-react-hooks": "^5.1.0-beta-e7d213dfb0-20240507",
    "eslint-plugin-vtex": "2.2.0",
    "prettier": "^2.8.8",
    "typescript": "^4.6.3"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "sass": "^1.62.1"
  }
}